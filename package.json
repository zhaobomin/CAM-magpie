{
  "name": "@magpie-community/cam",
  "version": "0.1.0",
  "private": true,
  "description": "Context attachment management as a pure Magpie request-hook plugin",
  "type": "module",
  "main": "./src/index.ts",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4"
  },
  "magpie": {
    "hooks": "./src/hooks.ts",
    "page": {
      "title": "Attachments",
      "titles": {
        "zh": "上下文附件",
        "en": "Attachments"
      },
      "file": "./panel/index.html",
      "service": {
        "port": 17893,
        "option": "panelPort"
      }
    },
    "options": {
      "language": "zh",
      "auto": true,
      "allowRemote": false,
      "gatewayTimeoutMs": 10000,
      "maxFetchImages": 4,
      "maxFetchBytes": 12582912,
      "panelPort": 17893
    }
  },
  "scripts": {
    "test": "bun test tests/*.test.ts",
    "check": "bun test tests/*.test.ts",
    "build": "bun build src/index.ts src/hooks.ts --target bun --outdir dist"
  }
}
