{
  "name": "@magpie-community/cam",
  "version": "0.1.0",
  "private": true,
  "description": "Context attachment management as a pure Magpie request-hook plugin",
  "type": "module",
  "main": "./src/index.ts",
  "license": "MIT",
  "repository": "github:zhaobomin/CAM-magpie",
  "files": [
    "src/",
    "scripts/configure-agents.js",
    "vendor/cam/",
    "panel/app.js",
    "panel/attachments.html",
    "panel/icon.svg",
    "NOTICE.md"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "magpie": {
    "icon": "https://raw.githubusercontent.com/zhaobomin/CAM-magpie/main/panel/icon.svg",
    "hooks": "./src/hooks.ts",
    "page": {
      "title": "Attachments",
      "titles": {
        "zh": "上下文附件",
        "en": "Attachments"
      },
      "file": "./panel/attachments.html",
      "icon": "panel/icon.svg"
    },
    "options": {
      "language": "zh",
      "auto": true,
      "allowRemote": false,
      "gatewayTimeoutMs": 10000,
      "maxFetchImages": 4,
      "maxFetchBytes": 12582912
    }
  },
  "scripts": {
    "configure:agents": "bun scripts/configure-agents.js",
    "test": "bun test tests/*.test.ts",
    "check": "bun test tests/*.test.ts",
    "build": "bun build src/index.ts src/hooks.ts --target bun --outdir dist"
  }
}
